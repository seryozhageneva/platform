{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(uv run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.prod*)",
      "Read(**/.env.dev*)",
      "Read(**/.env.test*)",
      "Read(**/.env.stag*)",
      "Bash(cat *.env)",
      "Bash(cat *.env *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --recursive *)",
      "Bash(sudo rm *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 60,
            "statusMessage": "Форматирование и линтер"
          }
        ]
      }
    ]
  }
}
