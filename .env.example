# Образец файла настроек. Сам файл с секретами называется .env и лежит рядом.
# Как пользоваться: скопируй этот файл в .env и впиши значения после знака «=».
# Файл .env не попадает в git (см. .gitignore). Этот образец — попадает, поэтому значений в нём нет.
# Имена переменных базы и очереди закреплены в задаче 01; ИИ-модели — в задаче 07 (ADR 0012).

# --- ИИ-модель ---

# Какой провайдер используется: gigachat (основной) или fake (заглушка без сети, ключ не нужен)
LLM_PROVIDER=

# Ключ авторизации GigaChat API из личного кабинета разработчика.
# Это секрет: никому не показывай и не вставляй в чат с Claude.
GIGACHAT_AUTH_KEY=

# Тип доступа GigaChat: для физического лица — GIGACHAT_API_PERS (подставится само, если пусто)
GIGACHAT_SCOPE=

# Какая модель отвечает, если блок не попросил другую. Пусто — GigaChat-2.
GIGACHAT_MODEL=

# Путь к файлу корневого сертификата «Russian Trusted Root CA»: им подписаны серверы GigaChat.
# Файл скачивается с Госуслуг (gosuslugi.ru/crt) и кладётся в папку certs/ — она не попадает в git.
# Пример: certs/russian_trusted_root_ca.cer
# Проверка сертификатов не отключается: без этого файла GigaChat не подключится.
GIGACHAT_CA_BUNDLE_FILE=

# --- База данных PostgreSQL ---

# Пароль базы. С ним docker compose создаёт базу при первом запуске.
# Это секрет. Придумать и записать его, не показывая на экране, можно одной командой в терминале:
#   printf '\nPOSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 16)" >> .env
POSTGRES_PASSWORD=

# Адрес базы в виде postgresql+asyncpg://пользователь:пароль@адрес:порт/имя_базы
# На своём компьютере оставь пустым: адрес соберётся сам из POSTGRES_PASSWORD
# (postgresql+asyncpg://platform:ПАРОЛЬ@localhost:5432/platform).
# Заполняется только там, где база живёт по другому адресу, — на сервере пилота.
DATABASE_URL=

# --- Очередь Redis ---

# Адрес Redis в виде redis://адрес:порт/номер
# На своём компьютере можно оставить пустым: используется redis://127.0.0.1:6379/0.
REDIS_URL=

# --- Подключения к внешним системам (задача 23, ADR 0028) ---

# Ключ, которым платформа шифрует токены подключений (Moodle и другие) в базе.
# Это секрет. Создать и записать, не показывая на экране:
#   printf '\nPLATFORM_SECRET_KEY=%s\n' "$(uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')" >> .env
# Если ключ потерять или сменить, сохранённые подключения придётся создать заново.
PLATFORM_SECRET_KEY=

# Ящик, от имени которого платформа отправляет уведомления (ADR 0033).
# Для почты заполни хост, логин и пароль приложения. Без них отправка почты отключена.
# 465 — TLS сразу, 587 — STARTTLS. Если адрес отправителя пуст, берётся логин.
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=465
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM=

# --- Тестовый Moodle в Docker (docker-compose.moodle.yml) ---

# Пароли тестового Moodle: администратора (вход admin на http://localhost:8080) и его базы.
# Это секреты. Создать и записать, не показывая на экране:
#   printf '\nMOODLE_ADMIN_PASSWORD=%s\nMOODLE_DB_PASSWORD=%s\n' "$(openssl rand -hex 12)" "$(openssl rand -hex 16)" >> .env
MOODLE_ADMIN_PASSWORD=
MOODLE_DB_PASSWORD=

# --- Сервер (docker-compose.prod.yml, задача 24a, ADR 0030, docs/deploy.md) ---

# Домен сайта без https://, например platform.example.ru. Caddy получит для него сертификат.
# Для репетиции на своём компьютере — localhost.
# Только в .env: в репозиторий адрес сервера не попадает.
PLATFORM_DOMAIN=

# Адрес песочницы для кода. На своём компьютере пусто — http://127.0.0.1:8001 (ADR 0025).
# На сервере его задаёт docker-compose.prod.yml.
PLATFORM_SANDBOX_URL=

# Где слушает API и чьим заголовкам X-Forwarded-* верить. На своём компьютере оставь пустыми
# (127.0.0.1 и 127.0.0.1). На сервере их задаёт docker-compose.prod.yml.
PLATFORM_API_HOST=
PLATFORM_TRUSTED_PROXIES=
