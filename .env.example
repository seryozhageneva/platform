# Образец файла настроек. Сам файл с секретами называется .env и лежит рядом.
# Как пользоваться: скопируй этот файл в .env и впиши значения после знака «=».
# Файл .env не попадает в git (см. .gitignore). Этот образец — попадает, поэтому значений в нём нет.
# Имена переменных базы и очереди закреплены в задаче 01; ИИ-модели — закрепляются в задаче 07.

# --- ИИ-модель ---

# Какой провайдер используется: gigachat (основной) или fake (подделка для тестов, ключ не нужен)
LLM_PROVIDER=

# Ключ авторизации GigaChat API из личного кабинета разработчика.
# Это секрет: никому не показывай и не вставляй в чат с Claude.
GIGACHAT_AUTH_KEY=

# Тип доступа GigaChat: для физического лица обычно GIGACHAT_API_PERS
GIGACHAT_SCOPE=

# --- База данных PostgreSQL ---

# Пароль базы. С ним docker compose создаёт базу при первом запуске.
# Это секрет. Придумать и записать его, не показывая на экране, можно одной командой в терминале:
#   printf '\nPOSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 16)" >> .env
POSTGRES_PASSWORD=

# Адрес базы в виде postgresql+asyncpg://пользователь:пароль@адрес:порт/имя_базы
# На своём компьютере оставь пустым: адрес соберётся сам из POSTGRES_PASSWORD
# (postgresql+asyncpg://platform:ПАРОЛЬ@localhost:5432/platform).
# Заполняется только там, где база живёт по другому адресу, — на сервере пилота.
DATABASE_URL=

# --- Очередь Redis ---

# Адрес Redis в виде redis://адрес:порт/номер
# На своём компьютере: redis://localhost:6379/0
REDIS_URL=
